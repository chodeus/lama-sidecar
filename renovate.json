{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>chodeus/chodeus-ops"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The rapidocr wheel detect.py fetches its detection model from; rapidocr-pin.yml rewrites the URL and hashes on Renovate's PR.",
      "managerFilePatterns": ["/^detect\\.py$/"],
      "matchStrings": ["\"rapidocr-(?<currentValue>[0-9][^\"-]*)-py3-none-any\\.whl\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "rapidocr"
    }
  ]
}
